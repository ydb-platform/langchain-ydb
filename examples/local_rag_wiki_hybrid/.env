# Local YDB and Ollama defaults. Edit this same file to use Yandex Cloud.
# To use Yandex Cloud, set RAG_WIKI_MODEL_PROVIDER=yc, replace the YDB
# connection values, and fill in YC_FOLDER_ID, YC_API_KEY, and one YDB auth field.

RAG_WIKI_MODEL_PROVIDER=local
RAG_WIKI_DOCUMENTS=20
RAG_WIKI_LLM_MODEL=llama3.1

YDB_HOST=localhost
YDB_PORT=2136
YDB_DATABASE=/local
YDB_TABLE=langchain_ydb_local_rag_hybrid
YDB_SECURE=false
YDB_DROP_EXISTING_TABLE=true
YDB_IAM_TOKEN=
YDB_SERVICE_ACCOUNT_KEY_FILE=

YC_FOLDER_ID=
YC_API_KEY=

# Cloud YDB example: host without grpcs://, port 2135, secure=true, and the
# database path from the YDB connection page in the Yandex Cloud console.
# YDB_HOST=ydb.serverless.yandexcloud.net
# YDB_PORT=2135
# YDB_DATABASE=/ru-central1/<cloud-id>/<database-id>
# YDB_TABLE=langchain_ydb_hybrid_cloud_demo
# YDB_SECURE=true
# YDB_DROP_EXISTING_TABLE=false
# YDB_IAM_TOKEN=<YDB IAM token>
# YDB_SERVICE_ACCOUNT_KEY_FILE=/path/to/authorized-key.json
# RAG_WIKI_MODEL_PROVIDER=yc
# YC_FOLDER_ID=<folder id>
# YC_API_KEY=<service account API key for YandexGPT>

# Yandex AI Studio: API key for embeddings and YandexGPT.
YC_FOLDER_ID=
YC_API_KEY=
YC_EMBEDDING_REQUEST_INTERVAL=0.25

# YDB connection. For Yandex Cloud, use the gRPC host, port 2135 and TLS.
YDB_HOST=
YDB_PORT=2135
YDB_DATABASE=
YDB_SECURE=true
YDB_TABLE=orbita

# YDB authentication is separate from YC_API_KEY. Fill in exactly one option.
YDB_IAM_TOKEN=
YDB_SERVICE_ACCOUNT_KEY_FILE=
